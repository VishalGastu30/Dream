# ============================================================
# .env.example — Template for environment variables
# Copy to .env and fill in real values.
# NEVER commit a real .env file — it is in .gitignore.
# See .agents/rules/60-security-privacy.md for the full spec.
# ============================================================

# Public site URL (no trailing slash)
# Use the Cloudflare Pages URL until a custom domain is set
SITE_URL=https://your-project.pages.dev

# ---- AI (Phase 7) ----
# Groq API key — free plan, no card required
# Get from: console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ---- Auth (Phase 6) — Better Auth + GitHub OAuth ----
# Create a GitHub OAuth App at: github.com/settings/developers
# Homepage URL: same as SITE_URL
# Callback URL: https://your-project.pages.dev/api/auth/callback/github
GITHUB_OAUTH_CLIENT_ID=your_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_client_secret_here

# Random 32+ byte hex string — generate with: openssl rand -hex 32
AUTH_SECRET=replace_with_32_byte_hex_string

# Your numeric GitHub user ID (NOT your username)
# Find it at: api.github.com/users/YOUR_USERNAME
OWNER_GITHUB_ID=123456789

# ---- Spam protection (Phase 6) ----
# Cloudflare Turnstile — believed free, verify at: developers.cloudflare.com/turnstile/
TURNSTILE_SECRET=your_turnstile_secret_here

# ---- CI only — set as GitHub Actions secret, not here ----
# GITHUB_TOKEN is set automatically by GitHub Actions
# It is a read-only token for syncing public repo metadata
# Do NOT add it to .env — it only lives in GitHub Actions secrets
