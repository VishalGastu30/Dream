# apps/api/.dev.vars.example
# Local development secrets for wrangler dev --local
# NEVER commit the actual .dev.vars file — only this .dev.vars.example
# Copy to .dev.vars and fill in real values:
#   cp apps/api/.dev.vars.example apps/api/.dev.vars

SITE_URL=http://localhost:3000
ENVIRONMENT=development

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate a random 32-byte secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_32_random_bytes_hex

# Your numeric GitHub user ID: https://api.github.com/users/YOUR_USERNAME
OWNER_GITHUB_ID=your_numeric_github_user_id

# GitHub OAuth App (create at: github.com/settings/developers)
# Callback URL: http://localhost:8787/api/auth/callback
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

# ─── Dev bypass (local only — NEVER in production) ───────────────────────────
# Set to "true" to enable the /api/auth/dev-login endpoint (bypasses OAuth)
DEV_BYPASS_AUTH=true

# ─── AI (Phase 7) ────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
ENABLE_ASK_ME=false
AI_DAILY_CAP=200

# ─── Spam prevention ─────────────────────────────────────────────────────────
# Turnstile test keys (always pass in testing, never use in production):
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
