{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "wrangler d1 migrations apply dream-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dream-db"
  },
  "dependencies": {
    "@dream/schema": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.0.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.0.0"
  }
}
